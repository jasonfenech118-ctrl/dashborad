# Copy this file to .env and fill in real values. Never commit .env.

DJANGO_SECRET_KEY=generate-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=

# --- Supabase Postgres connection ---------------------------------------
# Find these in Supabase: Project Settings -> Database -> Connection info.
# Leave PGHOST blank to use a local sqlite file instead (for quick testing).
PGHOST=db.jucunagrwqkzdfajmblg.supabase.co
PGPORT=5432
PGDATABASE=postgres
PGUSER=postgres
PGPASSWORD=your-database-password
PGSSLMODE=require

# --- Email (sending ordering forms to Logistics) ------------------------
# Leave EMAIL_BACKEND unset to just print emails to the server log (nothing
# is actually sent). To send for real, switch to the SMTP backend and fill
# in the account the emails are sent FROM. For a Gmail account use an
# "App Password" (Google Account -> Security -> App passwords), not your
# normal password. NOTE: on PythonAnywhere, outbound SMTP requires a paid
# account.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-address@gmail.com
# EMAIL_HOST_PASSWORD=your-16-char-app-password
# DEFAULT_FROM_EMAIL=Stoma Care Clinic <your-address@gmail.com>

# Where ordering forms are sent for processing (defaults to the address below).
LOGISTICS_EMAIL=logisticsdept.mdh@gov.mt
