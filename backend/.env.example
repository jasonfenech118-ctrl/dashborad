# Copy this file to .env and fill in real values. Never commit .env.

DJANGO_SECRET_KEY=generate-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=

# --- Database -------------------------------------------------------------
# Django owns the schema. Choose ONE backend by filling in its vars:
#
# 1) MySQL (e.g. PythonAnywhere's bundled database) — set MYSQL_HOST etc.
# 2) Postgres (e.g. Supabase / external) — set PGHOST etc. instead.
# 3) Leave both blank to use a local sqlite file (quick local testing).

# --- MySQL (PythonAnywhere) ---
# On PythonAnywhere: Databases tab -> create a database + set a password.
MYSQL_HOST=YOURUSERNAME.mysql.pythonanywhere-services.com
MYSQL_PORT=3306
MYSQL_DATABASE=YOURUSERNAME$default
MYSQL_USER=YOURUSERNAME
MYSQL_PASSWORD=your-mysql-password

# --- Postgres (alternative) ---
# PGHOST=
# PGPORT=5432
# PGDATABASE=postgres
# PGUSER=postgres
# PGPASSWORD=
# PGSSLMODE=require
